# Copy to .env.local for local dev. Real values live only in .env.local and Vercel env.
# Never commit secrets, tokens or private iCal URLs.

# --- Database (Neon via Vercel Marketplace; local dev can use plain Postgres) ---
DATABASE_URL=postgres://localhost:5432/victor_picks
DATABASE_URL_UNPOOLED=

# --- Site ---
# Until the custom domain exists this is the *.vercel.app host (no scheme).
PUBLIC_HOST=localhost:3000
# Optional deploy-time override; the day-to-day switch is the settings table row.
SHOW_ATTENDANCE=

# --- Admin auth (Better Auth, week 2) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=

# --- Subscribers ---
# HMAC key for confirm / prefs / unsubscribe links (any long random string; changing it voids every
# link already mailed). Without it, or without DATABASE_URL, the subscribe form stays closed.
SUBSCRIBER_LINK_SECRET=
# Newsletter form gate (src/lib/newsletter/status.ts). Leave empty for the default:
#   locally and in CI the form is open whenever DATABASE_URL and SUBSCRIBER_LINK_SECRET are set
#   (with no RESEND_API_KEY the confirmation email is printed to the server log);
#   on Vercel it opens only once RESEND_API_KEY is set and RESEND_FROM is on our own verified
#   domain (not @resend.dev, which only delivers to the Resend account owner).
# 0 closes it anywhere. 1 opens it on Vercel without a verified sender (owner testing only).
# Env is read at build time for the header, footer and sitemap links: changing it needs a redeploy.
NEWSLETTER_OPEN=
# Daily budget for all subscription email (confirmations, "already subscribed", resubscribe), so a
# sign-up flood can't spend Resend Free's 100/day that magic links and the digest also need.
# Default 40; roughly 100 minus active subscribers minus a margin.
SUBSCRIBE_DAILY_SEND_CAP=
# Weekly digest. DIGEST_SENDING=0 stops the digest cron anywhere (on Vercel it also stays off until a
# verified sender exists). DIGEST_DAILY_CAP: newsletter emails (digest and going alerts) per UTC day
# (default 60; Resend Free is 100/day shared with magic links and subscription mail); overflow goes out
# with the next day's run.
DIGEST_SENDING=
DIGEST_DAILY_CAP=
# Going alerts (F20; crons at 15:00 and 16:00 UTC). They follow the digest's gate (off on Vercel until a
# verified sender exists; logged to the server console locally); ALERTS_SENDING=0 turns only them off,
# which also hides the opt-in checkboxes. ALERT_DAILY_CAP: alert emails per UTC day (default 30) within
# DIGEST_DAILY_CAP; overflow merges into the next day's alert.
ALERTS_SENDING=
ALERT_DAILY_CAP=
# Seed inboxes for /admin/digest "Send to seed inboxes" (comma-separated, at most 10; the guide asks
# for one each at gmail.com, icloud.com, outlook.com, qq.com, 163.com). Only works with a verified
# sender. Mark it sensitive on Vercel; never shown in full anywhere.
DIGEST_SEED_EMAILS=
# Contact address printed on /privacy (data requests, takedowns). Kept out of the repo because it is
# public. On Vercel the subscribe form stays closed until it is set (NEWSLETTER_OPEN=1 overrides).
# Never falls back to ADMIN_EMAIL (the sign-in address). Read at build time: changing it needs a redeploy.
PRIVACY_CONTACT_EMAIL=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Must be an address on our own domain verified in Resend (e.g. "Victor's Picks <picks@mail.example.com>")
# for the subscribe form to open on Vercel; the shared onboarding@resend.dev sender keeps it closed.
RESEND_FROM=

# --- Storage / infra ---
BLOB_READ_WRITE_TOKEN=
# Upstash via Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional; on Vercel the AI SDK authenticates to AI Gateway via OIDC.
AI_GATEWAY_API_KEY=
CRON_SECRET=

# --- Candidate inbox private feeds (secret URLs: .env.local / Vercel only) ---
GCAL_SECRET_ICS_URL=
LUMA_PERSONAL_ICS_URL=
PARTIFUL_ICS_URL=
# Optional: addresses whose ATTENDEE PARTSTAT counts as Victor's RSVP (comma-separated; defaults to ADMIN_EMAIL).
INBOX_EMAILS=

# --- P1 / P2 ---
BRAVE_SEARCH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENC_KEY=
